# Copy to secrets/memory.env in the stack directory (chmod 600) and fill in the values.
TZ=UTC
POSTGRES_USER=memory
POSTGRES_DB=kira_memory
POSTGRES_PASSWORD=
# API key for clients (X-API-Key), e.g. `openssl rand -base64 32`
MEMORY_API_KEY=
# password for the web UI login
MEMORY_UI_PASSWORD=
# 32+ random characters for the session cookie
SESSION_SECRET=
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
DEFAULT_USER_ID=kira
